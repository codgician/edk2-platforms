#string STR_MODULE_ABSTRACT             #language en-US "Instance of RNG Library"

#string STR_MODULE_DESCRIPTION          #language en-US "Mailbox TRNG library. Accepts only successful responses with the exact requested entropy length, rejects stale command-mismatch output, and erases its response scratch."
